# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build output (root-anchored so it doesn't shadow cmd/platform-guardian/)
/platform-guardian
dist/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Sonar / scanner artifacts
.scannerwork/

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Secrets and config — never commit these
.env
.env.*
*.tfvars
*.tfvars.json
*.tfstate
*.tfstate.backup
secrets.*
*secret*
*credentials*

# SARIF and scan output
*.sarif
guardian-report.*

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Fetched fresh by `make hook-scripts` from ffreis-platform-standards — not
# authored here. Listed individually (not `scripts/hooks/`) so repo-authored
# scripts in the same directory, like check_coverage_gate.sh, can be tracked.
scripts/hooks/check_merge_markers.sh
scripts/hooks/check_large_files.sh
scripts/hooks/check_binary_files.sh
scripts/hooks/check_commit_msg.sh
scripts/hooks/check_required_tools.sh
scripts/bootstrap_lefthook.sh
.bin/
